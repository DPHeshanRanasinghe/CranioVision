# ===== CranioVision .gitignore — `develop` branch =====
#
# `develop` is the DEVELOPER branch: it carries the complete runnable tree
# (src/ + backend/ + frontend/ + tests/) so a teammate can clone it and bring
# the system up. This is deliberately a different policy from `main`, which is
# a public showcase of the ML pipeline only.
#
# What still stays out, and why:
#   data/, models/, atlas_data/  — licensed or multi-GB; fetched, not cloned
#   outputs/                     — regenerated per run
#   pitch/                       — competition material, not part of the product
#
# See README.md ("Running the System") for how to obtain the untracked assets.

# ---------------------------------------------------------------------------
# Medical imaging data (BraTS is licensed — never commit scans)
# ---------------------------------------------------------------------------
*.nii
*.nii.gz
*.dcm
*.dicom

# Ignore data/ except the split manifest, which is just case IDs and is what
# makes the reported test-set numbers reproducible.
data/*
!data/splits/
data/splits/*
!data/splits/data_split.json

# ---------------------------------------------------------------------------
# Trained models and checkpoints (~455 MB — distributed out of band)
# ---------------------------------------------------------------------------
models/
*.pth
*.pt
*.ckpt
*.onnx
*.pb
*.h5
*.safetensors

# ---------------------------------------------------------------------------
# Pipeline outputs — regenerated by running the pipeline.
# Exception: the per-model test-set metrics are small, are the source of the
# ensemble's Dice-proportional weights, and back the numbers in the README.
# ---------------------------------------------------------------------------
outputs/*
!outputs/*_test_results.json
logs/
wandb/
mlruns/
lightning_logs/
runs/
tb_logs/

# ---------------------------------------------------------------------------
# Atlas templates — 4 MB, but fetched reproducibly:
#   python -m src.cranovision.atlas.download
# ---------------------------------------------------------------------------
atlas_data/

# ---------------------------------------------------------------------------
# Competition / pitch material — intentionally NOT on this branch
# ---------------------------------------------------------------------------
pitch/

# ---------------------------------------------------------------------------
# Notebooks
# ---------------------------------------------------------------------------
notebooks/
*.ipynb
.ipynb_checkpoints/
*.ipynb_checkpoints

# Exception: the validation study is a research deliverable — it is the
# reproducible artifact behind research/VALIDATION_REPORT.md and is meant to
# be run on Colab/Kaggle, so it must be tracked.
!research/validation_study.ipynb

# ---------------------------------------------------------------------------
# Node / Next.js  (frontend/node_modules is ~800 MB, .next ~75 MB)
# package-lock.json IS tracked here so installs are reproducible.
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Python build / cache artifacts
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# ---------------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------------
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Local development context, IDE files, AI assistant state
# ---------------------------------------------------------------------------
configs/
.claude/
.local-history/
CLAUDE.md
claude.md
DESIGN_BRIEF.md
.cursor/
.aider*
.continue/
.windsurf/
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# ---------------------------------------------------------------------------
# Operating system files
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ---------------------------------------------------------------------------
# Test / coverage tools
# ---------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
nosetests.xml
coverage.xml

# ---------------------------------------------------------------------------
# Environment files (secrets, API keys, machine-specific)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
secrets.json

# ---------------------------------------------------------------------------
# Temporary / scratch files
# ---------------------------------------------------------------------------
tmp/
temp/
*.tmp
*.bak
*.log
uploads/
_report_*.pdf
_v*check.pdf
_verify*.pdf
_final_check.pdf
_be*.log
